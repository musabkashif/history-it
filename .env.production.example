# HistoryIT production environment (Linux / Docker Compose on Ubuntu).
# Copy to the host as `.env` next to docker-compose.prod.yml.
# Fill placeholders. Never commit real secrets.
#
# Container paths below match docker-compose.prod.yml volume mounts.

# --- OpenAI ---
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=REPLACE_WITH_DEPLOYABLE_MODEL_ID
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_CACHED_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
OPENAI_TIMEOUT_SECONDS=900
OPENAI_MAX_OUTPUT_TOKENS=30000
OPENAI_REASONING_EFFORT=

# --- Google ---
# Host file: ./server/credentials/google-service-account.json (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
JOB_INDEX_SPREADSHEET_ID=REPLACE_WITH_JOB_INDEX_SPREADSHEET_ID
BENCHMARK_SPREADSHEET_ID=REPLACE_WITH_FROZEN_BENCHMARK_SPREADSHEET_ID

# --- Paths inside the api container ---
GOVERNING_DOCS_DIR=/service/governing
DIAGNOSTICS_DIR=/service/logs
PROJECT_REFERENCES_DIR=/service/project_references
# Leave empty to use the prompt baked into the image at /service/prompts/...
RUNTIME_PROMPT_PATH=

# --- Job controls ---
BATCH_SIZE=10
MAX_RETRIES=3
EXPENSIVE_BATCH_WARNING_USD=10
JOB_SPENDING_LIMIT_USD=100

# --- Image prep ---
IMAGE_ORIGINAL_MAX_BYTES=15000000
IMAGE_ORIGINAL_MAX_EDGE=8000
IMAGE_RESIZE_MAX_EDGE=4096
IMAGE_JPEG_QUALITY=95

# --- API authentication (preserved) ---
# Backend: when set, every /api/* route requires header X-API-Token matching this value.
# /health remains unauthenticated.
API_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# Frontend build arg (docker-compose.prod.yml → client image):
# VITE_API_TOKEN must match API_TOKEN so the operator console can call /api.
# Vite embeds VITE_* values into the JavaScript bundle at build time. Anyone who
# can load the UI can extract the token. Treat HTTP IP allowlisting (EC2 security
# group) as temporary. Broader client access needs HTTPS plus access protection
# (VPN, basic auth, SSO, or similar)—do not rely on a Vite-baked token alone.
VITE_API_TOKEN=REPLACE_WITH_SAME_TOKEN_AS_API_TOKEN

# Frontend API origin for production Compose builds is forced empty (same origin
# via Nginx). Do not set VITE_API_BASE_URL to http://localhost:8000 in production.
