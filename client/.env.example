# Local Vite: leave blank so /api and /health use the Vite proxy (same origin = cookies work).
# Do NOT set this to http://127.0.0.1:8000 while opening http://localhost:5173 — that
# cross-site mismatch drops the login session cookie and bounces you back to Sign in.
VITE_API_BASE_URL=

# Browser auth uses HttpOnly session cookies from POST /api/auth/login.
# Do not set VITE_API_TOKEN — it is no longer used and must not appear in builds.
