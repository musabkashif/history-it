# Local development defaults. For Ubuntu/Docker Compose production paths and
# login/HTTPS notes, copy ../.env.production.example and read deploy/PUBLIC_ACCESS.md.
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
GOVERNING_DOCS_DIR=./governing
JOB_INDEX_SPREADSHEET_ID=
BENCHMARK_SPREADSHEET_ID=
BATCH_SIZE=10
MAX_RETRIES=3
EXPENSIVE_BATCH_WARNING_USD=10
JOB_SPENDING_LIMIT_USD=100
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_CACHED_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
OPENAI_TIMEOUT_SECONDS=900
OPENAI_MAX_OUTPUT_TOKENS=30000
OPENAI_REASONING_EFFORT=
DIAGNOSTICS_DIR=./logs
RUNTIME_PROMPT_PATH=
PROJECT_REFERENCES_DIR=./project_references
IMAGE_ORIGINAL_MAX_BYTES=15000000
IMAGE_ORIGINAL_MAX_EDGE=8000
IMAGE_RESIZE_MAX_EDGE=4096
IMAGE_JPEG_QUALITY=95

# Shared demo login (required for browser access). Generate hash with:
#   python scripts/hash_password.py
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD_HASH=
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300

# Optional server-only trusted-client token (X-API-Token). Empty disables token auth
# and never opens the API. Do not put this value in any VITE_* variable.
API_TOKEN=

# Developer-only Tri Delta Box 19 F01 checkpoint / Frozen Benchmark harness.
# Default false: operator UI hides it and the API returns 403. Do not enable in
# production unless you intentionally need that calibration harness.
ENABLE_DEVELOPER_VERIFICATION=false

# MongoDB control plane. Leave these off until shadow writes are accepted.
# The URI is read from the environment and is never printed.
MONGODB_URI=
MONGODB_DATABASE=
CONTROL_PLANE_ENVIRONMENT=staging
DATABASE_CONTROL_PLANE_ENABLED=false
DATABASE_SHADOW_WRITES_ENABLED=false
DATABASE_BACKFILL_ENABLED=false
